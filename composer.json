{
    "name": "web-vision/deepl-write",
    "description": "DeepL Write support for TYPO3. Write better texts, translate to simple language",
    "type": "typo3-cms-extension",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "ext-dom": "*",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "web-vision/deepl-base": "^2.0.3@dev",
        "web-vision/deeplcom-deepl-php": "~1.18.0@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.70",
        "helmich/typo3-typoscript-lint": "^3.1.0",
        "phpstan/phpstan": "^2.1.42",
        "phpunit/phpunit": "^11.5.55",
        "saschaegerer/phpstan-typo3": "^2.1.1 || ^3.0.1",
        "typo3/cms-lowlevel": "^13.4 || ^14.3",
        "typo3/testing-framework": "^9.5.0"
    },
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "web-vision GmbH",
            "email": "hello@web-vision.de"
        }
    ],
    "minimum-stability": "dev",
    "extra": {
        "typo3/cms": {
            "extension-key": "deepl_write",
            "ignore-as-root": false,
            "web-dir": ".Build/Web",
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "app-dir": ".Build",
            "version": "2.0.0-dev"
        },
        "branch-alias": {
            "dev-main": "2.x-dev",
            "dev-1": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "optimize-autoloader": true,
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false,
            "block-abandoned": false
        },
        "policy": {
            "advisories": false,
            "abandoned": false
        }
    },
    "autoload": {
        "psr-4": {
            "WebVision\\DeeplWrite\\": "Classes/",
            "WebVision\\DeeplWrite\\Core13\\": "Core13/",
            "WebVision\\DeeplWrite\\Core14\\": "Core14/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebVision\\DeeplWrite\\Tests\\": "Tests/"
        }
    },
    "suggest": {
        "web-vision/deepltranslate-core": "*"
    },
    "prefer-stable": true
}
